{% extends '@admin/default_frame.twig' %}

{% set menus = ['setting', 'ai_chat_assistant', 'ai_chat_assistant_knowledge'] %}

{% block title %}AI チャットアシスタント{% endblock %}
{% block sub_title %}ナレッジ管理{% endblock %}

{% block main %}
    <form name="search_form" method="get" action="">
        <div class="c-outsideBlock">
            <div class="c-outsideBlock__contents">
                <div class="row justify-content-start">
                    <div class="col-4">
                        <div class="mb-2">
                            <label class="col-form-label">キーワード</label>
                            <input type="text" name="keyword" class="form-control" value="{{ keyword }}" placeholder="タイトル・本文で検索">
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="mb-2">
                            <label class="col-form-label">カテゴリ</label>
                            <input type="text" name="category" class="form-control" value="{{ category }}" placeholder="カテゴリ名">
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="mb-2">
                            <label class="col-form-label">&nbsp;</label>
                            <div>
                                <button type="submit" class="btn btn-ec-conversion px-4">検索</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="row justify-content-between mb-2">
                        <div class="col-6">
                            <a href="{{ url('admin_ai_chat_assistant_knowledge_new') }}" class="btn btn-ec-conversion px-5">
                                新規登録
                            </a>
                        </div>
                    </div>

                    {% if entities|length > 0 %}
                        <div class="card rounded border-0 mb-4">
                            <div class="card-body p-0">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th class="border-top-0 pt-2 pb-3 ps-3" style="width: 5%;">ID</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 30%;">タイトル</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 15%;">カテゴリ</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 10%;">状態</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 10%;">表示順</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 15%;">作成日</th>
                                            <th class="border-top-0 pt-2 pb-3" style="width: 15%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for entity in entities %}
                                            <tr>
                                                <td class="align-middle ps-3">{{ entity.id }}</td>
                                                <td class="align-middle">
                                                    <a href="{{ url('admin_ai_chat_assistant_knowledge_edit', {'id': entity.id}) }}">
                                                        {{ entity.title }}
                                                    </a>
                                                </td>
                                                <td class="align-middle">
                                                    {% if entity.category %}
                                                        <span class="badge badge-ec-blue">{{ entity.category }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="align-middle">
                                                    {% if entity.isActive %}
                                                        <span class="badge badge-ec-green">有効</span>
                                                    {% else %}
                                                        <span class="badge badge-ec-glay">無効</span>
                                                    {% endif %}
                                                </td>
                                                <td class="align-middle">{{ entity.displayOrder }}</td>
                                                <td class="align-middle">{{ entity.createDate|date_min }}</td>
                                                <td class="align-middle text-end pe-3">
                                                    <a href="{{ url('admin_ai_chat_assistant_knowledge_edit', {'id': entity.id}) }}" class="btn btn-sm btn-ec-regular me-1">
                                                        編集
                                                    </a>
                                                    <form method="post" action="{{ url('admin_ai_chat_assistant_knowledge_delete', {'id': entity.id}) }}" class="d-inline"
                                                          onsubmit="return confirm('本当に削除しますか？');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                                                        <button type="submit" class="btn btn-sm btn-ec-delete">削除</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        <div class="card rounded border-0">
                            <div class="card-body p-4">
                                <div class="text-center text-muted mb-4 h5">登録されているナレッジはありません。</div>
                                <div class="text-center text-muted">「新規登録」ボタンからナレッジを追加してください。</div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </form>
{% endblock %}
