{% extends '@admin/default_frame.twig' %}

{% set menus = ['setting', 'ai_chat_assistant', 'ai_chat_assistant_scenario'] %}

{% block title %}AI チャットアシスタント{% endblock %}
{% block sub_title %}シナリオ管理{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block main %}
    <form name="scenario_form" role="form" method="post"
          action="{% if scenario.id %}{{ url('admin_ai_chat_assistant_scenario_edit', {'id': scenario.id}) }}{% else %}{{ url('admin_ai_chat_assistant_scenario_new') }}{% endif %}">
        {{ form_widget(form._token) }}

        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <span class="card-title">シナリオ情報</span>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#scenarioInfo" aria-expanded="false" aria-controls="scenarioInfo">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="scenarioInfo">
                            <div class="card-body">
                                {% if scenario.id %}
                                    <div class="row mb-2">
                                        <div class="col-3">
                                            <div class="d-inline-block">
                                                <span>ID</span>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <p>{{ scenario.id }}</p>
                                        </div>
                                    </div>
                                {% endif %}

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>トリガーキーワード</span>
                                        <span class="badge badge-primary ms-1">必須</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.trigger_keyword) }}
                                        {{ form_errors(form.trigger_keyword) }}
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>マッチタイプ</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.trigger_type) }}
                                        {{ form_errors(form.trigger_type) }}
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>応答テキスト</span>
                                        <span class="badge badge-primary ms-1">必須</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.response_text, {'attr': {'style': 'height: 200px;'}}) }}
                                        {{ form_errors(form.response_text) }}
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>応答タイプ</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.response_type) }}
                                        {{ form_errors(form.response_type) }}
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>優先度</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.priority) }}
                                        {{ form_errors(form.priority) }}
                                        <small class="form-text text-muted">数値が大きいほど優先的にマッチします。</small>
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>状態</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.is_active) }}
                                        {{ form_errors(form.is_active) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ url('admin_ai_chat_assistant_scenario_index') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>シナリオ一覧</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">
                                    {{ scenario.id ? '更新' : '登録' }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
