{
    "name": "ec-cube/aichatassistant44",
    "type": "eccube-plugin",
    "description": "AIチャットアシスタント",
    "version": "1.1.3",
    "homepage": "https://github.com/routeflags/ec-cube-ai-chat-assistant42",
    "license": "GPL-2.0-only",
    "support": {
        "issues": "https://github.com/routeflags/ec-cube-ai-chat-assistant42/issues",
        "source": "https://github.com/routeflags/ec-cube-ai-chat-assistant42"
    },
    "authors": [
        {
            "name": "ROUTE FLAGS Co., Ltd.",
            "homepage": "https://blog.routeflags.com/",
            "role": "Developer"
        }
    ],
    "keywords": [
        "ec-cube",
        "ai",
        "chat",
        "openai",
        "anthropic",
        "gemini",
        "mcp",
        "webmcp"
    ],
    "require": {
        "php": ">=8.2",
        "ec-cube/plugin-installer": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^2.11",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/yaml": "^7.4",
        "doctrine/orm": "^3.0",
        "doctrine/dbal": "^4.0",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/form": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/translation": "^7.4",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\AiChatAssistant44\\": "./",
            "Eccube\\": "Tests/Stubs/Eccube",
            "Psr\\Log\\Test\\": "Tests/Stubs/Psr/Log/Test"
        }
    },
    "autoload-dev": {
        "Plugin\\AiChatAssistant44\\Tests\\": "Tests/"
    },
    "extra": {
        "code": "AiChatAssistant44"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist --warning-severity=5",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse -c phpstan.neon.dist --error-format=table",
        "md": "phpmd . text phpmd.xml",
        "metrics": "phpmetrics --exclude=\"vendor,Tests,artifacts,Documents\" --report-html=artifacts/phpmetrics --report-json=artifacts/phpmetrics/report.json .",
        "quality": [
            "@lint",
            "@stan",
            "@md"
        ],
        "quality:ci": [
            "@quality",
            "@metrics"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
