{
    "name": "ec-cube/aichatassistant42",
    "type": "eccube-plugin",
    "version": "1.0.0",
    "description": "EC-CUBE の商品情報に AI チャットで質問できるプラグインです。OpenAI / Anthropic / Google Gemini に対応しています。",
    "license": "GPL-2.0-only",
    "keywords": ["ec-cube", "ai", "chat", "openai", "anthropic", "gemini", "mcp"],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\AiChatAssistant42\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\AiChatAssistant42\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "code": "AiChatAssistant42"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist --warning-severity=5",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse -c phpstan.neon.dist --error-format=table",
        "md": "phpmd . text phpmd.xml",
        "metrics": "phpmetrics --exclude=\"vendor,Tests,artifacts,Documents\" --report-html=artifacts/phpmetrics --report-json=artifacts/phpmetrics/report.json .",
        "quality": ["@lint", "@stan", "@md"],
        "quality:ci": ["@quality", "@metrics"]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
