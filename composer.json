{
    "name": "routeflags/ec-cube-ai-chat-assistant42",
    "type": "eccube-plugin",
    "version": "1.0.0",
    "description": "EC-CUBE の商品情報に AI チャットで質問できるプラグインです。OpenAI / Anthropic / Google Gemini に対応しています。",
    "license": "GPL-2.0-only",
    "keywords": ["ec-cube", "ai", "chat", "openai", "anthropic", "gemini", "mcp"],
    "require": {
        "php": ">=8.0",
        "ec-cube/ec-cube": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\AiChatAssistant42\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\AiChatAssistant42\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "code": "AiChatAssistant42"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
