parameters:
    level: 8

    # 最小サポート 8.1 に合わせる（composer.json: php >=8.1）
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false

    # 複数ファイルで共有する配列形状の別名（PHPDoc の重複定義を避ける）
    typeAliases:
        # MCP ツール定義（ProductToolDefinition::DEFINITIONS の要素）
        mcpToolDefinition: 'array{type: string, name: string, description: string, input_schema: array<string, mixed>}'
        # ai_models.json の 1 モデル定義（未設定キーは既定値で補完されるため optional）
        aiModel: 'array{id: string, name?: string, description?: string, supports_tools?: bool, supports_reasoning_with_tools?: bool, cost_tier?: string, is_default?: bool}'
        # ai_models.json の 1 モデル定義 + 所属プロバイダ（getAllModels の戻り値）
        aiModelWithProvider: 'array{provider: string, id: string, name?: string, description?: string, supports_tools?: bool, supports_reasoning_with_tools?: bool, cost_tier?: string, is_default?: bool}'
        # ai_models.json の providers（AiModelRegistry が読み込む形式）
        aiModelProviders: 'array<string, array{name?: string, api_base?: string, models?: array<int, aiModel>}>'
        # チャット履歴の検索フィルタ（ChatHistoryController::extractFilters の戻り値）
        chatHistoryFilters: 'array{date_from: string, date_to: string, provider: string, model: string, status: string}'

    paths:
        - Command
        - Controller
        - DoctrineMigrations
        - Entity
        - EventListener
        - EventSubscriber
        - Repository
        - Service
        - Twig
        - Nav.php

    excludePaths:
        - Tests/*
        - vendor/*
        - var/*
        - node_modules/*
        - artifacts/*
        - Documents/*
        - DoctrineMigrations/*

    ignoreErrors:
        # EC-CUBE 本体とスタブが揃っていないため解決できない呼び出し（スタブ拡充で順次削減する）
        - '#Call to an undefined (method|static method) (Eccube|Doctrine)\\.*#'

        # Entity $id は Doctrine がリフレクションで代入するため誤検出
        - '#Property Plugin\\AiChatAssistant42\\Entity\\.*::\$id .* is never assigned#'
        # DBAL の fetchAllAssociative() は array<string, mixed> を返すため、行を組み立て直す
        # メソッドでは型が絞れない（返却形状は Tests/Matrix の DB 実走で検証している）
        - '#should return array<int, array\{.+\}> but returns (?:array<int,\s*|list<)array<string, mixed>>#'
