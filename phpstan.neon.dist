parameters:
    level: 5

    # 最小サポート 8.1 に合わせる（composer.json: php >=8.1）
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false

    paths:
        - Command
        - Controller
        - DoctrineMigrations
        - Entity
        - EventListener
        - EventSubscriber
        - Repository
        - Service
        - Twig
        - Nav.php

    excludePaths:
        - Tests/*
        - vendor/*
        - var/*
        - node_modules/*
        - artifacts/*
        - Documents/*
        - DoctrineMigrations/*

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # EC-CUBE 本体不在で static 解析できない Repository/Tool dispatch
        - '#Call to an undefined method Plugin\\AiChatAssistant42\\Repository.*#'
        - '#Method Plugin\\AiChatAssistant42\\Repository\\ProductRepository::execute.* is unused#'
        - '#Call to an undefined (method|static method) (Eccube|Doctrine)\\.*#'
        - '#Access to an undefined property.*#'

        # Entity $id は Doctrine がリフレクションで代入するため誤検出
        - '#Property Plugin\\AiChatAssistant42\\Entity\\.*::\$id .* is never assigned#'
        - '#Property Plugin\\AiChatAssistant42\\Repository\\ProductRepository::\$entityManager is never read#'

        # 動的ディスパッチ / by-ref は誤検出が多いため許容（将来厳格化）
        - '#Parameter .* by-ref type.*#'
        - '#Constant .* is unused#'
        - '#Property .* is never read.*#'
        - '#Method .* is unused#'
        - '#Unreachable statement.*#'
        - '#will always evaluate to.*#'
        - '#PHPDoc tag @param references unknown parameter.*#'
        - '#should return .* but returns.*#'
        - '#Negated boolean expression is always false#'
        - '#Offset .* does not exist on array.*#'
        - '#Cannot unset offset.*#'
        - '#If condition is always true#'
        -
            message: '#PHPDoc tag @SuppressWarnings has invalid value#'
            paths:
                - Controller/*
                - Repository/*
                - Service/*
                - EventSubscriber/*

        # EC-CUBE / Plugin Entity の動的プロパティ（将来 EC-CUBE スタブ導入後に再有効化）
        -
            message: '#Dynamic property on (Eccube\\Entity\\|Plugin\\).* is not supported in PHP 8\.2#'
            paths:
                - Entity/*

        # Doctrine Proxy / Entity
        -
            message: '#class .* is not final#'
            paths:
                - Entity/*

        # Twig 関連は暫定
        -
            message: '#Function twig_.* not found#'
            paths:
                - Twig/*

        -
            message: '#Call to an undefined method Twig\\.*#'
            paths:
                - Twig/*

        # EventSubscriber の Symfony 互換フォールバック（isMasterRequest は 5.4 で deprecated だが存在）
        - '#Call to an undefined method Symfony\\Component\\HttpFoundation\\Session\\SessionInterface::getFlashBag#'
        - '#Call to an undefined method Symfony\\Component\\HttpKernel\\Event\\ResponseEvent::isMasterRequest#'
