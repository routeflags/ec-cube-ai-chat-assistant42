<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="AiChatAssistant44"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        EC-CUBE plugin AiChatAssistant44 PHPMD ruleset。

        PHPMD 既定値から動かすのは次の 2 点のみ。
        - ShortVariable: 2 文字（$id / $qb / $ip など Doctrine・Symfony 慣例）を許容
        - StaticAccess: DateTime / DateTimeImmutable の static factory のみ例外

        Entity は EC-CUBE 慣例の getter/setter だけを持つデータクラスのため対象外。
        解析対象はコマンド引数（composer md）で絞る。vendor / node_modules を
        PDepend に読ませるとメトリクスが混線し、別メソッドの値が報告される。
    </description>

    <!-- 除外 -->
    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/Tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/artifacts/*</exclude-pattern>
    <exclude-pattern>*/Documents/*</exclude-pattern>
    <exclude-pattern>*/DoctrineMigrations/*</exclude-pattern>
    <exclude-pattern>*/Entity/*</exclude-pattern>

    <!-- Clean Code: StaticAccess は \DateTime 系のみ例外にするため、いったん除外して再定義する -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>

    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <properties>
            <property name="exceptions" value="DateTime,DateTimeImmutable"/>
        </properties>
    </rule>

    <!-- Complexity / Size / Coupling: PHPMD 既定値のまま -->
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>

    <!-- Naming: 2 文字変数は Doctrine/Symfony 慣例のため許容 -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2"/>
        </properties>
    </rule>

    <!-- Unused code -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- Controversial rules -->
    <rule ref="rulesets/controversial.xml"/>

</ruleset>